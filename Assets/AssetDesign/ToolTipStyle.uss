/* 툴팁 전체 컨테이너 */
.tooltip-container {
    display: flex;
    flex-direction: row;        /* 아이콘과 텍스트 가로 배치 */
    align-items: center;        /* 세로 중앙 정렬 */
    background-color: rgba(30, 30, 30, 0.95);
    border-width: 3px;          /* 테두리 살짝 두껍게 */
    border-color: rgb(255, 100, 0);
    padding: 20px;              /* 내부 여백을 늘려서 널널하게 */

    /* [크기 변경] 최소폭을 키우고 최대폭 제한을 넉넉하게 확장 */
    min-width: 450px;
    max-width: 650px;
    height: auto;
    flex-shrink: 0;
    overflow: hidden;
}

/* 아이콘 컨테이너 */
.item-icon-container {
    /* [크기 변경] 아이콘 크기를 60px -> 100px로 대폭 확장 */
    width: 100px;
    height: 100px;
    flex-shrink: 0;             /* 글자가 길어져도 아이콘 크기 유지 */
    background-color: rgb(45, 45, 45);
    margin-right: 20px;         /* 아이콘과 텍스트 사이 간격 늘림 */
    justify-content: center;
    align-items: center;
    border-radius: 8px;         /* 아이콘 각진 부분 살짝 부드럽게 */
}

/* 실제 아이콘 이미지 (컨테이너를 꽉 채우도록) */
.item-icon {
    width: 85%;
    height: 85%;
}

/* 텍스트 영역 (제목 + 설명) */
.item-info-section {
    flex-grow: 1;               /* 남은 공간 다 차지 */
    flex-shrink: 1;             /* 공간 모자라면 줄바꿈용 */
    flex-direction: column;     /* 제목 아래에 설명 */
    justify-content: center;
    height: auto;
}

/* 아이템 이름 */
.item-title {
    color: rgb(255, 100, 0);
    /* [크기 변경] 글씨 크기 24px -> 36px로 확대 */
    font-size: 36px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* 구분선 (필요시 사용) */
.divider {
    height: 2px;
    background-color: rgba(255, 100, 0, 0.3);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* 아이템 설명 */
.item-description {
    color: rgb(255, 200, 0);
    /* [크기 변경] 설명 글씨 크기 14px -> 20px로 확대 */
    font-size: 20px;
    margin-top: 8px;

    /* 줄바꿈 설정 */
    white-space: normal;
    word-wrap: break-word;

    /* [크기 변경] 기존 250px 제한을 풀고 부모 크기에 맞춤 */
    width: 100%;
    max-width: none;
}